    <!-- 1. CHỌN NHÀ CUNG CẤP AI MẶC ĐỊNH: "Gemini", "OpenAI", "DeepSeek", "Groq", "Ollama" -->
    <add key="ActiveAiProvider" value="Groq" />

    <!-- 2. GOOGLE GEMINI (https://aistudio.google.com/) -->
    <!-- HỖ TRỢ ĐA KHÓA (MULTI-KEY POOL): Có thể điền nhiều key phân tách bởi dấu phẩy (,) hoặc chấm phẩy (;) -->
    <!-- Hệ thống sẽ tự động Xoay Vòng (Round-Robin) và Tự Đổi Key Khác (Failover) nếu 1 key hết hạn mức / 429 -->
    <add key="GeminiApiKey" value="" />
    <add key="GeminiModel" value="gemini-3.6-flash" />

    <!-- 3. OPENAI (ChatGPT - https://platform.openai.com/api-keys) -->
    <add key="OpenAiApiKey" value="" />
    <add key="OpenAiModel" value="gpt-4o-mini" />
    <add key="OpenAiBaseUrl" value="https://api.openai.com/v1" />

    <!-- 4. DEEPSEEK (https://platform.deepseek.com/) -->
    <add key="DeepSeekApiKey" value="" />
    <add key="DeepSeekModel" value="deepseek-chat" />
    <add key="DeepSeekBaseUrl" value="https://api.deepseek.com/v1" />

    <!-- 5. GROQ (Miễn phí & Cực nhanh: https://console.groq.com/keys) -->
