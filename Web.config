<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- ========================================================================================= -->
    <!-- CHỌN NHÀ CUNG CẤP AI ƯU TIÊN SỐ 1: "Gemini", "Groq", "OpenAI", "OpenRouter", "Vilao", "DeepSeek", "Ollama" -->
    <!-- Khi provider số 1 gặp sự cố hoặc hết quota, hệ thống sẽ tự động chuyển sang provider tiếp theo -->
    <!-- ========================================================================================= -->
    <add key="ActiveAiProvider" value="Vilao" />

    <!-- 1. GOOGLE GEMINI (Khuyên dùng: Siêu thông minh, tiếng Việt chuẩn, phản hồi 1-2s, Miễn phí) -->
    <!-- Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey -->
    <!-- Hỗ trợ Multi-key Pool: Có thể điền nhiều key phân tách bởi dấu phẩy (,) để tự động xoay vòng -->
    <add key="GeminiApiKey" value="" />
    <add key="GeminiModel" value="gemini-2.0-flash" />

    <!-- 2. GROQ CLOUD (Khuyên dùng về TỐC ĐỘ: Phản hồi cực nhanh 0.5s - 1s, Miễn phí hoàn toàn) -->
    <!-- Lấy API key miễn phí tại: https://console.groq.com/keys -->
    <!-- Model khuyên dùng: "llama-3.3-70b-versatile" (Mô hình 70 tỷ tham số siêu thông minh) hoặc "qwen-2.5-32b" -->
    <add key="GroqApiKey" value="" />
    <add key="GroqModel" value="llama-3.3-70b-versatile" />
    <add key="GroqBaseUrl" value="https://api.groq.com/openai/v1" />

    <!-- 3. OPENAI CHÍNH CHỦ (ChatGPT: gpt-4o-mini, gpt-4o) -->
    <!-- Lấy API key tại: https://platform.openai.com/api-keys -->
    <add key="OpenAiApiKey" value="" />
    <add key="OpenAiModel" value="gpt-4o-mini" />
    <add key="OpenAiBaseUrl" value="https://api.openai.com/v1" />

    <!-- 4. OPENROUTER (Cổng 100+ mô hình: Claude 3.5 Sonnet, DeepSeek V3, Qwen 2.5...) -->
    <!-- Lấy API key tại: https://openrouter.ai/keys -->
    <add key="OpenRouterApiKey" value="" />
    <add key="OpenRouterModel" value="deepseek/deepseek-chat" />
    <add key="OpenRouterBaseUrl" value="https://openrouter.ai/api/v1" />

    <!-- 5. DEEPSEEK CHÍNH CHỦ -->
    <!-- Lấy API key tại: https://platform.deepseek.com/api_keys -->
    <add key="DeepSeekApiKey" value="" />
    <add key="DeepSeekModel" value="deepseek-chat" />
    <add key="DeepSeekBaseUrl" value="https://api.deepseek.com/v1" />

    <!-- 6. VILAO AI GATEWAY (https://api.vilao.ai/v1) -->
    <add key="VilaoApiKey" value="sk-00bc0e596617a9410b5885f2807af73c350f08e29ca5041169815536d6cf7fd1" />
    <add key="VilaoModel" value="deepseek-v4-flash" />
    <add key="VilaoBaseUrl" value="https://api.vilao.ai/v1" />

    <!-- 7. OLLAMA LOCAL (Chạy offline trên máy cá nhân không cần mạng - http://localhost:11434) -->
    <add key="OllamaBaseUrl" value="http://localhost:11434/v1" />
    <add key="OllamaModel" value="llama3" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="524288" executionTimeout="3600" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="vi-VN" uiCulture="vi-VN" />
    <sessionState mode="InProc" timeout="10080" cookieName="ASP.NET_SessionId" />
