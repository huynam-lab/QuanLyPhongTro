        function togglePayment(id) {
            fetch('@Url.Action("CapNhatTrangThaiHoaDon", "Admin", new { area = "Host" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function xoaHoaDon(id, tenPhong, ky) {
            Swal.fire({
                title: 'Xóa hóa đơn điện nước?',
                text: 'Bạn có chắc chắn muốn xóa hóa đơn kỳ ' + ky + ' của phòng "' + tenPhong + '"?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('@Url.Action("XoaHoaDonDienNuoc", "Admin", new { area = "Host" })', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'id=' + id
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Đã xóa!', text: data.message, timer: 1500, showConfirmButton: false })
                                .then(() => location.reload());
                        } else {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                        }
                    });
                }
            });
        }
    </script>
}
