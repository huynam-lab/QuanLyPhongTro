@model QuanLyPhongTro.Areas.Admin.ChuNhaViewModels.QuanLyDienNuocVM
@{
    ViewBag.Title = "Quản lý điện nước";
    Layout = "~/Areas/Host/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3 px-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h5 class="fw-bold mb-0 text-dark text-nowrap">
                <i class="bi bi-lightning-charge text-warning me-2"></i>Quản Lý Điện Nước & Dịch Vụ
            </h5>
            <div class="text-muted small text-nowrap">
                Theo dõi chỉ số tiêu thụ điện nước, đơn giá và trạng thái thanh toán hóa đơn từng phòng
            </div>
        </div>

        <form method="get" action="@Url.Action("QuanLyDienNuoc", "Admin", new { area = "Host" })" class="d-flex flex-wrap align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 130px;">
                <span class="input-group-text bg-white"><i class="bi bi-calendar-event"></i></span>
                <select name="thang" class="form-select text-nowrap">
                    <option value="">-- Tháng --</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" @(Model.SelectedThang == m ? "selected" : "")>Tháng @m</option>
                    }
                </select>
            </div>

            <div class="input-group input-group-sm" style="width: 125px;">
                <span class="input-group-text bg-white"><i class="bi bi-calendar3"></i></span>
                <select name="nam" class="form-select text-nowrap">
                    <option value="">-- Năm --</option>
                    @if (Model.DanhSachNam != null)
                    {
                        foreach (var y in Model.DanhSachNam)
                        {
                            <option value="@y" @(Model.SelectedNam == y ? "selected" : "")>Năm @y</option>
                        }
                    }
                </select>
            </div>

            <div class="input-group input-group-sm" style="width: 165px;">
                <span class="input-group-text bg-white"><i class="bi bi-check2-circle"></i></span>
                <select name="trangThai" class="form-select text-nowrap">
                    <option value="">-- Tất cả TT --</option>
                    <option value="true" @(Model.SelectedTrangThai == true ? "selected" : "")>Đã thanh toán</option>
                    <option value="false" @(Model.SelectedTrangThai == false ? "selected" : "")>Chưa thanh toán</option>
                </select>
            </div>

            <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                <i class="bi bi-filter me-1"></i>Lọc
            </button>
            <a href="@Url.Action("QuanLyDienNuoc", "Admin", new { area = "Host" })" class="btn btn-sm btn-outline-secondary text-nowrap">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
            </a>
        </form>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-xl-3 col-sm-6">
            <div class="card p-3 shadow-sm border-start border-4 border-warning h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-nowrap">Tổng tiền điện</span>
                    <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-circle">
                        <i class="bi bi-lightning fs-6"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-dark text-nowrap">@Model.TongTienDien.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card p-3 shadow-sm border-start border-4 border-info h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-nowrap">Tổng tiền nước</span>
                    <div class="bg-info bg-opacity-10 text-info p-2 rounded-circle">
                        <i class="bi bi-droplet fs-6"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-dark text-nowrap">@Model.TongTienNuoc.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card p-3 shadow-sm border-start border-4 border-success h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-nowrap">Hóa đơn đã thu (@Model.SoHoaDonDaThu)</span>
                    <div class="bg-success bg-opacity-10 text-success p-2 rounded-circle">
                        <i class="bi bi-check2-all fs-6"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-success text-nowrap">@Model.TongTienDaThu.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card p-3 shadow-sm border-start border-4 border-danger h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-nowrap">Hóa đơn chưa thu (@Model.SoHoaDonChuaThu)</span>
                    <div class="bg-danger bg-opacity-10 text-danger p-2 rounded-circle">
                        <i class="bi bi-hourglass-split fs-6"></i>
                    </div>
                </div>
                <div class="fs-4 fw-bold text-danger text-nowrap">@Model.TongTienChuaThu.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="fw-bold text-dark text-nowrap">
                <i class="bi bi-table me-2 text-primary"></i>Danh Sách Hóa Đơn Điện Nước & Chi Phí
            </div>
            <div class="small text-muted text-nowrap">Tổng số: <b>@(Model.DanhSachHoaDon?.Count ?? 0)</b> bản ghi</div>
        </div>
        <div class="card-body p-0">
            @if (Model.DanhSachHoaDon != null && Model.DanhSachHoaDon.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 text-nowrap">Mã HĐ</th>
                                <th class="text-nowrap">Phòng trọ</th>
                                <th class="text-nowrap">Khách thuê</th>
                                <th class="text-center text-nowrap">Kỳ thu</th>
                                <th class="text-end text-nowrap">Tiêu thụ điện</th>
                                <th class="text-end text-nowrap">Tiêu thụ nước</th>
                                <th class="text-end text-nowrap">Tiền phòng</th>
                                <th class="text-end text-nowrap">Wifi</th>
                                <th class="text-end text-nowrap">Tổng tiền</th>
                                <th class="text-center text-nowrap">Hạn nộp</th>
                                <th class="text-center text-nowrap">Trạng thái</th>
                                <th class="text-center text-nowrap pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DanhSachHoaDon)
                            {
                                <tr>
                                    <td class="ps-3 text-nowrap"><span class="badge bg-light text-dark border">#@item.ID_Hoa_Don</span></td>
                                    <td class="fw-semibold text-dark text-nowrap">@item.TenPhong</td>
                                    <td class="text-nowrap">
                                        <div class="fw-semibold">@item.TenKhach</div>
                                        <small class="text-muted"><i class="bi bi-telephone me-1"></i>@item.SDT</small>
                                    </td>
                                    <td class="text-center fw-semibold text-nowrap">@item.Thang/@item.Nam</td>
                                    <td class="text-end text-nowrap">
                                        <div class="fw-semibold text-dark">@item.TienDien.ToString("N0") đ</div>
                                        <small class="text-muted">(@item.SoDien kWh)</small>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <div class="fw-semibold text-dark">@item.TienNuoc.ToString("N0") đ</div>
                                        <small class="text-muted">(@item.SoNuoc m³)</small>
                                    </td>
                                    <td class="text-end text-nowrap">@item.TienPhong.ToString("N0") đ</td>
                                    <td class="text-end text-nowrap">@item.TienWifi.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-primary text-nowrap">@item.TongTien.ToString("N0") đ</td>
                                    <td class="text-center small text-nowrap">@(item.HanThanhToan.HasValue ? item.HanThanhToan.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td class="text-center text-nowrap" id="status-cell-@item.ID_Hoa_Don">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Chưa thanh toán</span>
                                        }
                                    </td>
                                    <td class="text-center text-nowrap pe-3">
                                        <button type="button" class="btn btn-sm @(item.TrangThai ? "btn-outline-secondary" : "btn-outline-success") text-nowrap" onclick="togglePayment(@item.ID_Hoa_Don, this)">
                                            <i class="bi @(item.TrangThai ? "bi-arrow-repeat" : "bi-check2") me-1"></i>@(item.TrangThai ? "Hủy thu" : "Thu tiền")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted text-nowrap">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Không có hóa đơn điện nước nào phù hợp với bộ lọc
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        function togglePayment(id, btn) {
            fetch('@Url.Action("CapNhatTrangThaiHoaDon", "Admin", new { area = "Host" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'id=' + id
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var cell = document.getElementById('status-cell-' + id);
                    if (data.trangThai) {
                        cell.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Đã thanh toán</span>';
                        btn.className = 'btn btn-sm btn-outline-secondary text-nowrap';
                        btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Hủy thu';
                    } else {
                        cell.innerHTML = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Chưa thanh toán</span>';
                        btn.className = 'btn btn-sm btn-outline-success text-nowrap';
                        btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Thu tiền';
                    }
                }
            });
        }
    </script>
}
