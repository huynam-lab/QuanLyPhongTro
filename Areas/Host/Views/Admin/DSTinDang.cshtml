@model QuanLyPhongTro.Areas.Admin.ChuNhaViewModels.ChuNha
@{
    ViewBag.Title = "Danh sách tin đăng";
    Layout = "~/Areas/Host/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3 px-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-ul text-primary me-2"></i>Danh Sách Tin Đăng Phòng Trọ
            </h5>
            <div class="text-muted small">
                Khi phòng có người ở (có hợp đồng hiệu lực), bài đăng sẽ tự động chuyển sang trạng thái <b>Không hiển thị</b>
            </div>
        </div>
        <a href="@Url.Action("Index", "Admin", new { area = "Host" })" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>Đăng tin mới
        </a>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="input-group input-group-sm" style="max-width: 360px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input id="searchBox" type="text" class="form-control" placeholder="Tìm theo mã tin hoặc tiêu đề..." />
            </div>
            <div class="small text-muted">
                Tổng số: <b>@(Model?.PhongTros?.Count ?? 0)</b> bài đăng
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model?.PhongTros != null && Model.PhongTros.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tblTin">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 100px;">Mã tin</th>
                                <th>Tiêu đề bài đăng</th>
                                <th style="width: 140px;">Ngày đăng</th>
                                <th class="text-center" style="width: 220px;">Trạng thái hiển thị</th>
                                <th class="text-center pe-3" style="width: 160px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PhongTros)
                            {
                                <tr>
                                    <td class="ps-3"><span class="badge bg-light text-dark border">#@item.ID_Phong_Tro</span></td>
                                    <td class="fw-semibold text-dark">@item.Ten_Phong</td>
                                    <td>@(item.Ngay_Dang.HasValue ? item.Ngay_Dang.Value.ToString("dd/MM/yyyy") : "—")</td>
                                    <td class="text-center">
                                        @if (item.DangCoKhachThue)
                                        {
                                            <span class="badge bg-secondary px-2 py-1">
                                                <i class="bi bi-eye-slash me-1"></i>Không hiển thị (Đã có người ở)
                                            </span>
                                        }
                                        else if (item.Trang_Thai == true)
                                        {
                                            <span class="badge bg-success px-2 py-1">
                                                <i class="bi bi-eye me-1"></i>Đang hiển thị
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1">
                                                <i class="bi bi-eye-slash me-1"></i>Không hiển thị / Chờ duyệt
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm">
                                            @if (!item.DangCoKhachThue)
                                            {
                                                <button type="button" class="btn @(item.Trang_Thai == true ? "btn-outline-secondary" : "btn-outline-success")"
                                                        title="@(item.Trang_Thai == true ? "Ẩn bài đăng" : "Bật hiển thị bài đăng")"
                                                        onclick="toggleHienThi(@item.ID_Phong_Tro)">
                                                    <i class="bi @(item.Trang_Thai == true ? "bi-eye-slash" : "bi-eye")"></i>
                                                </button>
                                            }
                                            <a href="@Url.Action("UpdateData", "Admin", new { area = "Host", id = item.ID_Phong_Tro })"
                                               class="btn btn-outline-primary" title="Sửa bài đăng">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" title="Xóa bài đăng" onclick="xoaBaiDang(@item.ID_Phong_Tro, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Ten_Phong))')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486751.png" width="120" class="mb-3 opacity-75" />
                    <p class="fs-6 text-muted mb-1">Chưa có tin đăng nào</p>
                    <p class="small">Bấm <a href="@Url.Action("Index", "Admin", new { area = "Host" })" class="text-primary fw-semibold">vào đây</a> để bắt đầu đăng tin</p>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchBox = document.getElementById("searchBox");
            const rows = document.querySelectorAll("#tblTin tbody tr");
            if (!searchBox) return;

            searchBox.addEventListener("input", function () {
                const kw = this.value.toLowerCase().trim();
                rows.forEach(row => {
                    const maTin = row.children[0].textContent.toLowerCase();
                    const tieuDe = row.children[1].textContent.toLowerCase();
                    row.style.display = (maTin.includes(kw) || tieuDe.includes(kw)) ? "" : "none";
                });
            });
        });

        function toggleHienThi(id) {
            fetch('@Url.Action("ToggleHienThiTin", "Admin", new { area = "Host" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Thành công', text: data.message, timer: 1500, showConfirmButton: false })
                        .then(() => location.reload());
                } else {
                    Swal.fire({ icon: 'warning', title: 'Thông báo', text: data.message });
                }
            });
        }

        function xoaBaiDang(id, ten) {
            Swal.fire({
                title: 'Xóa bài đăng phòng trọ?',
                text: 'Bạn có chắc chắn muốn xóa phòng "' + ten + '" khỏi hệ thống?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('@Url.Action("XoaPhongTroAjax", "Admin", new { area = "Host" })', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'id=' + id
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Đã xóa!', text: data.message, timer: 1500, showConfirmButton: false })
                                .then(() => location.reload());
                        } else {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                        }
                    });
                }
            });
        }
    </script>
}
