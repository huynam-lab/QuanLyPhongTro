
@{
    ViewBag.Title = "ChiTiet";
}
@model QuanLyPhongTro.Models.Phong_Tro

<link href="~/Assets/Css/ChiTiet.css" rel="stylesheet" />
@{
    ViewBag.Title = Model.Ten_Phong; // Lấy tiêu đề từ tên phòng
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy các biến phụ từ Model cho dễ dùng
    var hinhAnh = Model.Hinh_Anh.ToList();
    var noiBat = Model.Noi_Bat.FirstOrDefault(); // Giả sử mỗi phòng chỉ có 1 dòng Nổi bật

    // Xử lý nút Yêu thích
    var userFavorites = (List<int>)ViewBag.UserFavorites ?? new List<int>();
    var isFavorited = userFavorites.Contains(Model.ID_Phong_Tro);
    var heartIconClass = isFavorited ? "bi-heart-fill" : "bi-heart";
    var activeClass = isFavorited ? "active" : "";
    // Lấy 2 danh sách tin liên quan từ ViewBag
    var relatedPosts = ViewBag.RelatedPosts as List<QuanLyPhongTro.Models.Phong_Tro>;
    var latestPosts = ViewBag.LatestPosts as List<QuanLyPhongTro.Models.Phong_Tro>;

    // 1. Lấy địa chỉ từ Model. Nếu không có thì dùng địa chỉ mặc định.
    var diaChi = Model.Dia_Chi ?? "Việt Nam";

    // 2. Mã hóa địa chỉ này để Google hiểu (ví dụ: đổi dấu cách thành %20)
    var diaChiEncoded = Url.Encode(diaChi);

    // 3. Tạo link embed động cho iframe
    // (z=16 là mức zoom, bạn có thể thay đổi)
    var mapEmbedUrl = string.Format("https://maps.google.com/maps?q={0}&output=embed&t=m&z=16", diaChiEncoded);

    // 4. Tạo link "Xem bản đồ lớn" (dùng để mở tab mới)
    var mapSearchUrl = string.Format("https://www.google.com/maps/search/?api=1&query={0}", diaChiEncoded);

    var avatarNguoiDang = (Model.Tai_Khoan != null && !string.IsNullOrEmpty(Model.Tai_Khoan.Avata))
        ? "~/Assets/Images/Avatar/" + Model.Tai_Khoan.Avata
        : "~/Assets/Images/Avatar/avatar-mac-dinh.jpg";
}
@Html.AntiForgeryToken()
<div class="container mt-4">
    <div class="row">

        <div class="col-lg-8">

            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb" style="background-color: #f8f9fa; padding: 0.5rem 1rem; border-radius: 0.25rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Cho thuê phòng trọ</a></li>
                    <li class="breadcrumb-item"><a href="#">@(Model.Khu_Vuc != null ? Model.Khu_Vuc.Ten_KV : "...")</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Ten_Phong</li>
                </ol>
            </nav>

            <div id="phongTroCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner rounded">
                    @if (hinhAnh.Any())
                    {
                        for (int i = 0; i < hinhAnh.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Url.Content("~/Kho/Img/" + hinhAnh[i].Url_Anh)" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="Ảnh @(i+1)">
                            </div>
                        }
                    }
                    else
                    {
                        <div class="carousel-item active">
                            <img src="@Url.Content("~/Kho/Img/placeholder.jpg")" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="Chưa có ảnh">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#phongTroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#phongTroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>

                <div class="carousel-indicators" style="position: static; margin-top: 10px;">
                    @for (int i = 0; i < hinhAnh.Count; i++)
                    {
                        <button type="button" data-bs-target="#phongTroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="true" aria-label="Slide @(i+1)" style="width: 100px; height: 70px;">
                            <img src="@Url.Content("~/Kho/Img/" + hinhAnh[i].Url_Anh)" class="d-block w-100" style="height: 70px; object-fit: cover; border-radius: 5px;" alt="Thumbnail @(i+1)">
                        </button>
                    }
                </div>
            </div>

            <div class="mt-4">
                <span class="badge bg-danger mb-2">@Model.Loai_Tin.Ten_LoaiTin</span>
                <div class="mb-1">
                    <i class="bi bi-star-fill text-warning"></i>
                    <i class="bi bi-star-fill text-warning"></i>
                    <i class="bi bi-star-fill text-warning"></i>
                    <i class="bi bi-star-fill text-warning"></i>
                    <i class="bi bi-star-fill text-warning"></i>
                </div>
                <h1 class="h2 text-danger fw-bold">@Model.Ten_Phong</h1>

                <div class="d-flex flex-wrap align-items-center text-muted mt-3 mb-3">
                    <span class="fw-bold text-success fs-4 me-4">@(Model.Gia_Ca.HasValue ? string.Format("{0:0.#} triệu/tháng",(decimal)Model.Gia_Ca.Value/1_000_000M) : "Thỏa thuận")</span>
                    <span class="me-4"><i class="bi bi-rulers me-1"></i> @Model.Dien_Tich m²</span>
                    <span><i class="bi bi-clock me-1"></i> Cập nhật: @(Model.Ngay_Dang.HasValue ? Model.Ngay_Dang.Value.ToString("dd/MM/yyyy") : "...")</span>
                </div>
            </div>

            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item d-flex justify-content-between">
                    <strong>Mã tin:</strong>
                    <span>#@Model.ID_Phong_Tro</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <strong>Địa chỉ:</strong>
                    <span class="text-end">@Model.Dia_Chi</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <strong>Quận/Huyện:</strong>
                    <span>@(Model.Khu_Vuc != null ? Model.Khu_Vuc.Ten_KV : "...")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <strong>Ngày đăng:</strong>
                    <span>@(Model.Ngay_Dang.HasValue ? Model.Ngay_Dang.Value.ToString("dd/MM/yyyy") : "...")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <strong>Ngày hết hạn:</strong>
                    <span>@(Model.Ngay_Het_Han.HasValue ? Model.Ngay_Het_Han.Value.ToString("dd/MM/yyyy") : "...")</span>
                </li>
            </ul>

            <!-- Thông tin mô tả -->
            <div class="mb-4">
                <h3 class="h5 fw-bold mb-3">Thông tin mô tả</h3>
                <div class="text-muted" style="line-height: 1.7;">
                    @Html.Raw(Model.Mo_Ta.Replace("**##split##", "<br />").Replace("##split##", "<br />"))
                </div>
            </div>

            <div class="mb-4">
                <h3 class="h5 fw-bold mb-3">Nổi bật</h3>
                @if (noiBat != null)
                {
                    <div class="row">

                        <!-- CỘT 1 (Đổi col-md-6 thành col-md-4) -->
                        <div class="col-md-4">
                            <ul class="list-unstyled">
                                <!--
                                    SỬA LOGIC:
                                    - Đổi icon "bi-x-circle" thành "bi-check-circle-fill"
                                    - Đổi class "text-muted" thành "text-muted opacity-75"
                                -->
                                <li class="mb-2 @(noiBat.Day_du_noi_that == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Đầy đủ nội thất
                                </li>
                                <li class="mb-2 @(noiBat.Co_may_giat == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Có máy giặt
                                </li>
                                <li class="mb-2 @(noiBat.Gio_giac_tu_do == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Giờ giấc tự do
                                </li>
                                <li class="mb-2 @(noiBat.Co_may_lanh == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Có điều hòa
                                </li>
                            </ul>
                        </div>

                        <!-- CỘT 2 (Đổi col-md-6 thành col-md-4) -->
                        <div class="col-md-4">
                            <ul class="list-unstyled">
                                <li class="mb-2 @(noiBat.Co_gac == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Có gác
                                </li>
                                <li class="mb-2 @(noiBat.Co_tu_lanh == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Có tủ lạnh
                                </li>
                                <li class="mb-2 @(noiBat.Co_bao_ve_24_24 == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Bảo vệ 24/24
                                </li>
                                <li class="mb-2 @(noiBat.Co_thang_may == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Có thang máy
                                </li>
                            </ul>
                        </div>

                        <!-- THÊM MỚI CỘT 3 (col-md-4) -->
                        <div class="col-md-4">
                            <ul class="list-unstyled">
                                <li class="mb-2 @(noiBat.Ke_bep == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Kệ bếp
                                </li>
                                <li class="mb-2 @(noiBat.Co_may_lanh == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Có máy lạnh
                                </li>
                                <li class="mb-2 @(noiBat.Khong_chung_chu == true ? "text-success" : "text-muted opacity-75")">
                                    <i class="bi bi-check-circle-fill me-2"></i>Không chung chủ
                                </li>

                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">Không có thông tin nổi bật.</p>
                }
            </div>

            <div class="mb-4">
                <h3 class="h5 fw-bold mb-3">Vị trí & bản đồ</h3>

                <!-- Hiển thị địa chỉ và link "Xem bản đồ lớn" (giống ảnh mẫu) -->
                <p class="text-muted d-flex justify-content-between align-items-center">
                    <span>
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        Địa chỉ: @Model.Dia_Chi
                    </span>
                    <a href="@mapSearchUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                        Xem bản đồ lớn
                    </a>
                </p>

                <!--
                    SỬA Ở ĐÂY:
                    Thay thế src cố định bằng @mapEmbedUrl động
                -->
                <iframe src="@mapEmbedUrl"
                        width="100%"
                        height="400"
                        style="border:0; border-radius: 8px;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
            <!-- ============================================== -->
            <!-- KẾT THÚC PHẦN VỊ TRÍ & BẢN ĐỒ -->
            <!-- ============================================== -->

            <div class="mb-4">
                <h3 class="h5 fw-bold mb-3">Thông tin liên hệ</h3>
                <div class="card p-3 post-contact-box-bottom">
                    <div class="row g-3 align-items-center">
                        <!-- Avatar -->
                        <div class="col-md-2 col-3 text-center">
                            <img src="@Url.Content(avatarNguoiDang)" class="rounded-circle" alt="Avatar"
                                 style="width: 80px; height: 80px; object-fit: cover; border: 2px solid #eee;">
                        </div>
                        <!-- Info -->
                        <div class="col-md-5 col-9">
                            <h6 class="fw-bold mb-0">@(Model.Tai_Khoan != null ? Model.Tai_Khoan.Name : "...")</h6>
                            <p class="text-muted small mb-1">
                                <span class="text-success me-1" style="font-size: 0.7rem; vertical-align: middle;">●</span> Đang hoạt động
                            </p>
                            <p class="text-muted small mb-0">
                                @Model.Tai_Khoan.Phong_Tro.Count() tin đăng • Tham gia từ: @(Model.Tai_Khoan != null && Model.Tai_Khoan.Ngay_Tao.HasValue ? Model.Tai_Khoan.Ngay_Tao.Value.ToString("dd/MM/yyyy") : "...")
                            </p>
                        </div>
                        <!-- Buttons -->
                        <div class="col-md-5">
                            <a href="tel:@(Model.Tai_Khoan != null ? Model.Tai_Khoan.SDT : "#")" class="btn btn-success d-block w-100 mb-2 fw-bold">
                                <i class="bi bi-telephone-fill me-2"></i>@(Model.Tai_Khoan != null ? Model.Tai_Khoan.SDT : "...")
                            </a>
                            <a href="#" class="btn btn-primary d-block w-100 fw-bold">
                                <i class="bi bi-chat-dots-fill me-2"></i> Nhắn Zalo
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- LƯU Ý (GIỐNG ẢNH MẪU) -->
            <!-- ============================================== -->
            <div class="post-note-box">
                <span class="note-title">Lưu ý:</span>
                <p>Chỉ đặt cọc khi xác định được chủ nhà và có thỏa thuận biên nhận rõ ràng. Kiểm tra mọi điều khoản và yêu cầu liệt kê tất cả chi phí hàng tháng vào hợp đồng. <a href="#">Xem thêm</a></p>
                <p>Mọi thông tin liên quan đến tin đăng này chỉ mang tính chất tham khảo. Nếu bạn thấy rằng tin đăng này không đúng hoặc có dấu hiệu lừa đảo, <a href="#">hãy phản ánh với chúng tôi</a>.</p>
            </div>
            <!-- KHỐI MỚI: TIN ĐĂNG CÙNG KHU VỰC -->
            @if (relatedPosts != null && relatedPosts.Any())
            {
                <div class="related-posts-section" id="related-posts">
                    <div class="section-header">
                        <h3 class="fw-bold">Tin đăng cùng khu vực</h3>
                        <div class="scroll-buttons">
                            <button class="btn btn-light scroll-prev" type="button"><i class="bi bi-chevron-left"></i></button>
                            <button class="btn btn-light scroll-next" type="button"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                    <div class="related-posts-container">
                        @foreach (var post in relatedPosts)
                        {
                            var hinhAnhDauTien = post.Hinh_Anh.Any() ? Url.Content("~/Kho/Img/" + post.Hinh_Anh.First().Url_Anh) : Url.Content("~/Kho/Img/placeholder.jpg");
                            var itemClass = (post.ID_LoaiTin == 1 || post.ID_LoaiTin == 2) ? "has-banner" : "";

                            <div class="related-post-card @itemClass">
                                <a href="@Url.Action("ChiTiet", "User", new { id = post.ID_Phong_Tro })">
                                    <div class="card-image">
                                        <div class="featured-post-banner"></div>
                                        <img src="@hinhAnhDauTien" alt="@post.Ten_Phong" />
                                        <div class="image-count-overlay-small"><i class="bi bi-camera-fill me-1"></i>@post.Hinh_Anh.Count</div>
                                    </div>
                                    <div class="card-content">
                                        <h6 class="title">@post.Ten_Phong</h6>
                                        <span class="price">@(post.Gia_Ca.HasValue ? string.Format("{0:0.#} triệu/tháng",(decimal)post.Gia_Ca.Value/1_000_000M) : "Thỏa thuận")</span>
                                        <span class="location">@(post.Khu_Vuc?.Ten_KV ?? "...")</span>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- KHỐI MỚI: TIN ĐĂNG MỚI CẬP NHẬT -->
            @if (latestPosts != null && latestPosts.Any())
            {
                <div class="related-posts-section" id="latest-posts">
                    <div class="section-header">
                        <h3 class="fw-bold">Tin đăng mới cập nhật</h3>
                        <div class="scroll-buttons">
                            <button class="btn btn-light scroll-prev" type="button"><i class="bi bi-chevron-left"></i></button>
                            <button class="btn btn-light scroll-next" type="button"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                    <div class="related-posts-container">
                        @foreach (var post in latestPosts)
                        {
                            var hinhAnhDauTien = post.Hinh_Anh.Any() ? Url.Content("~/Kho/Img/" + post.Hinh_Anh.First().Url_Anh) : Url.Content("~/Kho/Img/placeholder.jpg");
                            var itemClass = (post.ID_LoaiTin == 1 || post.ID_LoaiTin == 2) ? "has-banner" : "";

                            <div class="related-post-card @itemClass">
                                <a href="@Url.Action("ChiTiet", "User", new { id = post.ID_Phong_Tro })">
                                    <div class="card-image">
                                        <div class="featured-post-banner"></div>
                                        <img src="@hinhAnhDauTien" alt="@post.Ten_Phong" />
                                        <div class="image-count-overlay-small"><i class="bi bi-camera-fill me-1"></i>@post.Hinh_Anh.Count</div>
                                    </div>
                                    <div class="card-content">
                                        <h6 class="title">@post.Ten_Phong</h6>
                                        <span class="price">@(post.Gia_Ca.HasValue ? string.Format("{0:0.#} triệu/tháng",(decimal)post.Gia_Ca.Value/1_000_000M) : "Thỏa thuận")</span>
                                        <span class="location">@(post.Khu_Vuc?.Ten_KV ?? "...")</span>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

        </div> <div class="col-lg-4">
            <div class="sticky-sidebar-wrapper" style="position: sticky; top: 1rem;">
                <div class="card mb-3">
                    <div class="card-body text-center">
                        <img src="@Url.Content(Model.Tai_Khoan != null && !string.IsNullOrEmpty(Model.Tai_Khoan.Avata) ? "~/Assets/Images/Avatar/" + Model.Tai_Khoan.Avata : "~/Assets/Images/Avatar/avatar-mac-dinh.jpg")"
                             class="rounded-circle mb-3" alt="Avatar" style="width: 100px; height: 100px; object-fit: cover;">
                        <h5 class="card-title fw-bold">@(Model.Tai_Khoan != null ? Model.Tai_Khoan.Name : "...")</h5>
                        <p class="text-muted small">Đang hoạt động</p>

                        <a href="tel:@(Model.Tai_Khoan != null ? Model.Tai_Khoan.SDT : "#")" class="btn btn-success btn-lg d-block w-100 mb-2 fw-bold">
                            <i class="bi bi-telephone-fill me-2"></i>@(Model.Tai_Khoan != null ? Model.Tai_Khoan.SDT : "...")
                        </a>
                        <a href="#" class="btn btn-primary btn-lg d-block w-100 mb-3 fw-bold">
                            <i class="bi bi-chat-dots-fill me-2"></i> Nhắn Zalo
                        </a>

                        <div class="d-flex justify-content-around">
                            <a href="#" class="btn-favorite @activeClass" data-post-id="@Model.ID_Phong_Tro" style="font-size: 1rem; color: #6c757d;">
                                <i class="bi @heartIconClass me-1"></i> Lưu tin
                            </a>
                            <a href="#" class="text-muted" style="text-decoration: none;">
                                <i class="bi bi-share-fill me-1"></i> Chia sẻ
                            </a>
                            <a href="#" class="text-muted" style="text-decoration: none;">
                                <i class="bi bi-flag-fill me-1"></i> Báo xấu
                            </a>
                        </div>
                    </div>
                </div>

                <!-- ========== BẮT ĐẦU WIDGET TIN NỔI BẬT (ĐÃ SỬA) ========== -->
                <div class="featured-posts-widget">
                    <h5 class="fw-bold mb-3">Tin đăng nổi bật</h5>

                    @{
                        // Lấy danh sách tin nổi bật từ ViewBag
                        var featuredPosts = ViewBag.FeaturedPosts as List<QuanLyPhongTro.Models.Phong_Tro>;
                    }

                    @if (featuredPosts != null && featuredPosts.Any())
                    {
                        // Lặp qua từng tin
                        foreach (var post in featuredPosts)
                        {
                            var hinhAnhDauTien = post.Hinh_Anh.Any()
                                ? Url.Content("~/Kho/Img/" + post.Hinh_Anh.First().Url_Anh)
                                : Url.Content("~/Kho/Img/placeholder.jpg");

                            // Thêm class 'has-banner' nếu tin là loại 1 hoặc 2
                            var itemClass = (post.ID_LoaiTin == 1 || post.ID_LoaiTin == 2) ? "has-banner" : "";

                            <div class="featured-post-item @itemClass">
                                <a href="@Url.Action("ChiTiet", "User", new { id = post.ID_Phong_Tro })" class="row g-2">

                                    <!-- Cột ảnh (có banner) -->
                                    <div class="col-4" style="position: relative;">
                                        <!-- Banner (chỉ hiển thị nếu có class 'has-banner') -->
                                        <div class="featured-post-banner">
                                        </div>
                                        <img src="@hinhAnhDauTien" class="img-fluid rounded" alt="@post.Ten_Phong">
                                    </div>

                                    <!-- Cột nội dung -->
                                    <div class="col-8">
                                        <h6 class="mb-1 text-pink title-clamp-2">
                                            @post.Ten_Phong
                                        </h6>
                                        <strong class="text-success d-block fw-bold">
                                            @(post.Gia_Ca.HasValue ? string.Format("{0:0.#} triệu/tháng",(decimal)post.Gia_Ca.Value/1_000_000M) : "Thỏa thuận")
                                        </strong>
                                        <small class="text-muted">
                                            @(post.Ngay_Dang.HasValue ? post.Ngay_Dang.Value.ToString("dd/MM/yyyy") : "...")
                                        </small>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Không có tin nổi bật nào.</p>
                    }

                </div>

            </div>
        </div>
    </div>
</div> @section Scripts {
    <script>
        $(document).ready(function () {

          var token = $('input[name="__RequestVerificationToken"]').val();

            $('.btn-favorite').on('click', function (e) {
                e.preventDefault();
                var $this = $(this);
                var postId = $this.data('post-id');

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("ToggleFavorite", "Home")", // Sửa "Home" nếu cần
                    data: { id: postId },
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function (data) {
                        if (data.success) {
                            if (data.isFavorited) {
                                // (Không nên xảy ra, vì đây là trang Tin Đã Lưu)
                                $this.addClass('active');
                                $this.find('i').removeClass('bi-heart').addClass('bi-heart-fill');
                            } else {
                                // CẢI TIẾN: Bỏ thích thì tin sẽ biến mất
                                $this.closest('.card, .listing-card').fadeOut(400, function () {
                                    $(this).remove();
                                    // Kiểm tra xem còn tin nào không
                                    if ($('.listing-card, .card.shadow-sm').length === 0) {
                                        $('.col-lg-8.offset-lg-2').append('<div class="alert alert-info mt-4">Bạn không còn tin nào đã lưu.</div>');
                                        // Ẩn phân trang nếu hết tin
                                        $('.pagination-container').hide();
                                    }
                                });
                            }
                        }
                    },
                    error: function (xhr, status, error) {
                        if (xhr.status == 401) {
                            alert("Bạn cần đăng nhập để thực hiện việc này.");
                        } else {
                            alert("Đã xảy ra lỗi. Vui lòng thử lại.");
                        }
                    }
                });
            });
            function setupCarouselScroll(sectionId) {
                const container = $('#' + sectionId + ' .related-posts-container');
                const scrollAmount = 286; // (width 270 + gap 16)

                $('#' + sectionId + ' .scroll-prev').on('click', function () {
                    container.animate({
                        scrollLeft: '-=' + scrollAmount
                    }, 300);
                });

                $('#' + sectionId + ' .scroll-next').on('click', function () {
                    container.animate({
                        scrollLeft: '+=' + scrollAmount
                    }, 300);
                });
            }

            // Kích hoạt cho cả 2 carousel
            setupCarouselScroll('related-posts');
            setupCarouselScroll('latest-posts');
        });

    </script>
}
