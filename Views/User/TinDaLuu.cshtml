
@{
    ViewBag.Title = "Tin quan tâm - Phongtro123.com";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using PagedList;
@using PagedList.Mvc;
@model IPagedList<QuanLyPhongTro.Models.Phong_Tro>

<!-- (Bạn có thể link file Index.css ở đây nếu các class CSS nằm riêng) -->
<!-- <link href="~/Assets/Css/Index.css" rel="stylesheet" /> -->
<link href="~/Assets/Css/Index.css" rel="stylesheet" />
