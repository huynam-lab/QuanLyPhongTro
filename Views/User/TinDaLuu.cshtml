@section Scripts {
    <!-- Script cho nút Yêu thích (giữ nguyên) -->
    <script>
       $(document).ready(function () {

    // 1. Lấy thẻ input chứa Token
    var tokenInput = $('input[name="__RequestVerificationToken"]');
    var token = tokenInput.val();

    // Lấy tên tham số (để phòng trường hợp nó không phải là __RequestVerificationToken)
    // Mặc định là __RequestVerificationToken, nhưng lấy động cho chắc ăn.
    var tokenName = tokenInput.attr('name');

    // Tạo object dữ liệu để gửi đi
    var dataToSend = { id: 0 }; // Giá trị id tạm thời
    dataToSend[tokenName] = token; // Thêm token vào object với tên đúng

    $('.btn-favorite').on('click', function (e) {
        e.preventDefault();
        var $this = $(this);
        var postId = $this.data('post-id');

        // Cập nhật ID cho object dữ liệu
        dataToSend.id = postId;

        $.ajax({
            type: "POST",
            url: "@Url.Action("ToggleFavorite", "User")",

            // 2. Gửi data đã có Token (với tên đúng)
            data: dataToSend,

            success: function (data) {
                if (data.success) {
                    if (data.isFavorited) {
                        $this.addClass('active');
                        $this.find('i').removeClass('bi-heart').addClass('bi-heart-fill');
                        if ($this.contents().length > 1 && $this.contents().last()[0].nodeType === 3) {
                            $this.contents().last().replaceWith("");
                        }
                    } else {
                        $this.removeClass('active');
                        $this.find('i').removeClass('bi-heart-fill').addClass('bi-heart');
                        if ($this.contents().length > 1 && $this.contents().last()[0].nodeType === 3) {
                            $this.contents().last().replaceWith("");
                        }
                        if ($('.listing-card, .card.shadow-sm').length === 0) {
                            $('.col-lg-8.offset-lg-2').append('<div class="alert alert-info mt-4">Bạn không còn tin nào đã lưu.</div>');
                            // Ẩn phân trang nếu hết tin
                            $('.pagination-container').hide();
                        }
                    }
                } else {
                     // Nếu server trả về false (ví dụ chưa đăng nhập), hiển thị thông báo từ server
                    alert(data.message);

                    // Nếu chưa đăng nhập, có thể chuyển hướng
                    // window.location.href = "@Url.Action("Login", "Account")";
                }
            },
            error: function (xhr, status, error) {
                if (xhr.status == 401) {
                    alert("Bạn cần đăng nhập để thực hiện việc này.");
                } else {
                    console.error("Lỗi chi tiết:", xhr.responseText);
                    alert("Đã xảy ra lỗi kết nối (" + xhr.status + "). Vui lòng thử lại.");
                }
            }
        });
    });
});
    </script>
}

<!-- (Hàm Helper cho thời gian, nếu bạn muốn dùng) -->
@helper Helper_GetTimeAgo(DateTime postDate)
{
    TimeSpan diff = DateTime.Now - postDate;
    if (diff.TotalDays >= 1)
    {
        @(((int)diff.TotalDays).ToString("N0") + " ngày trước")
    }
    else if (diff.TotalHours >= 1)
    {
        @(((int)diff.TotalHours).ToString("N0") + " giờ trước")
    }
    else if (diff.TotalMinutes >= 1)
    {
        @(((int)diff.TotalMinutes).ToString("N0") + " phút trước")
    }
    else
    {
        @("Vừa xong")
    }
}

