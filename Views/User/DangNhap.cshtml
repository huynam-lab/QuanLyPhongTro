@{
    ViewBag.Title = "Đăng Nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Assets/Css/DangNhap.css" rel="stylesheet" />
<link href="~/Assets/Css/ToastDangKy.css" rel="stylesheet" />

<!-- Font Awesome để dùng icon mắt (chỉ cần thêm 1 lần trong toàn site) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

<div class="pt-main-content-wrapper">
    <div class="login-container">

        <!-- Tab Switcher -->
        <div class="login-tabs" id="loginTabs">
            <a href="@Url.Action("DangNhap", "User")" class="active-tab text-decoration-none">Đăng nhập</a>
            <a href="@Url.Action("DangKy", "User")" class="text-decoration-none">Tạo tài khoản mới</a>
        </div>

        <!-- Form Đăng Nhập -->
        <form id="loginForm" method="post" action="@Url.Action("DangNhap", "User")">
            <div class="input-group">
                <input type="text"
                       class="form-control-custom"
                       id="phoneNumber"
                       name="SDT"
                       placeholder="Số điện thoại"
                       value="@ViewBag.AttemptedUserName"
                       required
                       autocomplete="username">
            </div>

            <div class="input-group password-wrapper">
                <input type="password"
                       class="form-control-custom"
                       id="password"
                       name="Pass"
                       placeholder="Mật khẩu"
                       required
                       autocomplete="current-password">

                <!-- Icon mắt xem/ẩn mật khẩu -->
                <span class="toggle-password" id="togglePassword" title="Hiển thị mật khẩu">
                    <i class="fa fa-eye-slash" id="eyeIcon"></i>
                </span>
            </div>

            <button type="submit" class="btn-primary-custom">Đăng nhập</button>
            <a href="@Url.Action("QuenMatKhau", "User")" class="forgot-link">Bạn quên mật khẩu?</a>
        </form>

        <!-- Điều khoản -->
        <p class="legal-text text-center">
            Qua việc đăng nhập hoặc tạo tài khoản, bạn đồng ý với các
            <a href="@Url.Action("QuyDinhSuDung", "User")">quy định sử dụng</a>
            cũng như <a href="@Url.Action("ChinhSachBaoMat", "User")">chính sách bảo mật</a> của chúng tôi.
        </p>
        <p class="legal-text text-center">Bản quyền © 2015 - 2025 Phongtro123.com</p>
    </div>

    <!-- Modal Thành công -->
    <div id="successModal" class="custom-modal-backdrop">
        <div class="custom-modal">
            <div class="modal-content">
                <div class="icon-wrapper success-wrapper">
                    <svg class="icon-checkmark" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" />
                    </svg>
                </div>
                <p class="modal-text success-text">Bạn đã đăng nhập thành công</p>
                <button id="modalOkButtonSuccess" class="btn-ok btn-red">OK</button>
            </div>
        </div>
    </div>

    <!-- Modal Lỗi -->
    <div id="errorModal" class="custom-modal-backdrop">
        <div class="custom-modal">
            <div class="modal-content">
                <div class="icon-wrapper error-wrapper">
                    <svg class="icon-cross" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z" />
                    </svg>
                </div>
                <h3 class="modal-title">Lỗi Đăng Nhập</h3>
                <p class="modal-subtext">Thông báo lỗi</p>
                <button id="modalOkButtonError" class="btn-ok btn-blue">OK</button>
            </div>
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script>
    $(document).ready(function () {

        // ==================== ICON MẮT XEM/ẨN MẬT KHẨU ====================
        $('#togglePassword').on('click', function () {
            const passwordInput = $('#password');
            const icon = $('#eye');

            if (passwordInput.attr('type') === 'password') {
                passwordInput.attr('type', 'text');
                icon.removeClass('fa-eye-slash').addClass('fa-eye');
            } else {
                passwordInput.attr('type', 'password');
                icon.removeClass('fa-eye').addClass('fa-eye-slash');
            }
        });

        // ==================== XỬ LÝ ĐĂNG NHẬP THÀNH CÔNG / THẤT BẠI ====================
        const loginSuccess = '@ViewBag.LoginSuccess' === 'True';
        const hasError = '@ViewBag.HasError' === 'True';
        const errorType = '@ViewBag.ErrorType';
        const errorMessage = '@ViewBag.Error';
        const roleId = parseInt('@ViewBag.ID_Phan_Quyen') || 0;

        if (loginSuccess) {
            $('#successModal').css('display', 'flex');

            $('#modalOkButtonSuccess').on('click', function () {
                $('#successModal').css('display', 'none');

                let redirectUrl = '@Url.Action("Index", "User")'; // mặc định người dùng thường
                if (roleId === 1) { // Admin
                    redirectUrl = '@Url.Action("Dashboard", "Quantrivien", new { area = "Admin" })';
                }
                window.location.href = redirectUrl;
            });
        }
        else if (hasError) {
            const phoneInput = $('#phoneNumber');
            const passwordInput = $('#password');

            // Xóa viền đỏ cũ
            $('.form-control-custom').removeClass('input-error');

            const errorModal = $('#errorModal');
            let msg = errorMessage;

            if (errorType !== 'EmptyFields') {
                msg += '<br>Vui lòng thử lại.';
            }

            errorModal.find('.modal-subtext').html(msg);
            errorModal.css('display', 'flex');

            $('#modalOkButtonError').on('click', function () {
                errorModal.css('display', 'none');

                if (errorType === 'UserNotFound' || errorType === 'EmptyFields') {
                    phoneInput.addClass('input-error').focus();
                } else if (errorType === 'WrongPassword') {
                    passwordInput.addClass('input-error').focus();
                }
            });
        }
    });
</script>

<!-- CSS bổ sung cho icon mắt (thêm vào DangNhap.css hoặc inline) -->
<style>
    .password-wrapper {
        position: relative;
    }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #888;
        font-size: 18px;
        z-index: 5;
        transition: color 0.2s;
    }

        .toggle-password:hover {
            color: #333;
        }

    /* Đảm bảo input có chỗ cho icon */
    #password {
        padding-right: 50px !important;
    }

    /* Viền đỏ khi lỗi (nếu bạn đã có class input-error trong CSS) */
    .input-error {
        border-color: #e74c3c !important;
        box-shadow: 0 0 5px rgba(231, 76, 60, 0.5);
    }
</style>